{
    "name": "upsites/upcore",
    "description": "Baseline de seguranca e performance da UpSites para projetos WordPress.",
    "type": "wordpress-muplugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "UpCore\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
